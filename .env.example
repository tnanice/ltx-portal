# 首次初始化空数据库时必填（至少12位）；已有数据库后此项不再生效。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 镜像版本；升级时改这里，再 docker compose pull。
LTX_TAG=1.0.0
# 8896 被占用时改 APP_PORT。
APP_PORT=8896
BIND_IP=0.0.0.0

# 资源目录接口：首次启动自动拉取；目录与封面不随镜像分发。
CATALOG_URL=https://ltx.libray.workers.dev/api/items

# For LAN direct access, leave PUBLIC_URL empty.
# For an HTTPS reverse proxy, set the public URL and COOKIE_SECURE=true.
# Incoming X-Forwarded-* headers are intentionally not trusted.
PUBLIC_URL=
COOKIE_SECURE=false
ALLOWED_HOSTS=*

# Optional bundled Caddy TLS: also set BIND_IP=127.0.0.1 above.
DOMAIN=
